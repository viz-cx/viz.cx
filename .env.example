# Every env var the app reads. All have working defaults except MONGO_URL in
# production; the values below are the local-dev ones.

# --- storage ---
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=viz_platform
MEDIA_DIR=./media                        # uploaded images (app/api/upload, app/media)

# --- site ---
SITE_URL=http://localhost:3000           # absolute URLs in OG tags, RSS, sitemap, robots
ADMIN_ACCOUNTS=                          # comma-separated VIZ accounts allowed to edit/delete any post

# --- chain / API (server) ---
VIZ_RPC_HTTP=https://rpc.viz.cx          # lib/chain.ts account lookups (login key verify)
API_BASE=https://api.viz.cx              # lib/awards.ts award totals

# --- chain (client, inlined at build time) ---
NEXT_PUBLIC_VIZ_RPC_HTTP=https://rpc.viz.cx    # award broadcast endpoint
NEXT_PUBLIC_WS_URL=wss://api.viz.cx/ws/ops     # broadcast confirmation feed

# --- Sentry (all inert unless a DSN is set) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# SENTRY_AUTH_TOKEN — build-time only, uploads source maps when present
